NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Leave blank locally to use MongoDB Memory Server.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=slot_booking

# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret
# Login/session link validity. Examples: 30d, 90d, 365d.
JWT_EXPIRES_IN=30d

# Comma-separated frontend origins for the API CORS policy.
CLIENT_ORIGIN=http://localhost:5173

# Set this to the deployed API origin when frontend and backend are hosted separately.
# Leave blank when the production server serves both from one origin.
VITE_API_URL=

# Optional. If no key is set, Campus AI Assistant uses clearly labeled demo responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
